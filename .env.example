# MongoDB Connection URI
# Replace <db_password> with your actual MongoDB password
# You can use either MONGO_URI or MONGODB_URI (both are supported)
MONGO_URI=mongodb+srv://username:<db_password>@cluster0.xxxxx.mongodb.net/?appName=YourApp

# Alternative: Local MongoDB instance
# MONGO_URI=mongodb://localhost:27017

# Alternative: MongoDB with authentication
# MONGO_URI=mongodb://username:password@localhost:27017/admin
